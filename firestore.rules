rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isTrainer() {
      return signedIn()
        && (get(userPath(request.auth.uid)).data.role == 'trainer'
          || get(userPath(request.auth.uid)).data.userRole == 'trainer'
          || get(userPath(request.auth.uid)).data.user_role == 'trainer'
          || get(userPath(request.auth.uid)).data['user role'] == 'trainer');
    }

    function hasCoachAccess(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/coach_links/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(userId)/coach_links/$(request.auth.uid)).data.status == 'active';
    }

    function hasTrainerLibraryAccess(trainerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/coach_links/$(trainerId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/coach_links/$(trainerId)).data.status == 'active';
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/interest_chats/$(chatId);
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in get(chatPath(chatId)).data.participantIds;
    }

    function isFriendChatCreate() {
      return signedIn()
        && request.resource.data.type == 'friend_dm'
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds;
    }

    function isOwnUserProfileWrite(userId) {
      return signedIn()
        && request.auth.uid == userId
        && (!('role' in request.resource.data)
          || !('role' in resource.data)
          || request.resource.data.role == resource.data.role
          || (resource.data.role == null
            && request.resource.data.role == 'student'));
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || hasCoachAccess(userId));
      allow create: if signedIn()
        && request.auth.uid == userId
        && (!('role' in request.resource.data)
          || request.resource.data.role == 'student');
      allow update: if isOwnUserProfileWrite(userId);
      allow delete: if signedIn() && request.auth.uid == userId;

      match /workouts/{workoutId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || hasCoachAccess(userId));
        allow write: if signedIn() && request.auth.uid == userId;
      }

      match /food_entries/{entryId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || hasCoachAccess(userId));
        allow write: if signedIn() && request.auth.uid == userId;
      }

      match /saved_food_products/{productId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /coach_links/{trainerId} {
        allow read: if signedIn()
          && (request.auth.uid == userId
            || (resource.data.trainerId == request.auth.uid
              && resource.data.status == 'active'));
        allow create, update: if isTrainer()
          && request.auth.uid == trainerId
          && request.resource.data.trainerId == trainerId
          && request.resource.data.studentId == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.trainerId == trainerId
          && request.resource.data.studentId == userId
          && request.resource.data.status == 'active';
        allow delete: if signedIn()
          && (request.auth.uid == userId
            || (isTrainer() && request.auth.uid == trainerId));
      }

      match /recipe_assignments/{assignmentId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || hasCoachAccess(userId));
        allow create, update: if isTrainer()
          && hasCoachAccess(userId)
          && request.resource.data.studentId == userId
          && request.resource.data.trainerId == request.auth.uid;
        allow delete: if isTrainer()
          && hasCoachAccess(userId)
          && resource.data.trainerId == request.auth.uid;
      }

      match /workout_assignments/{assignmentId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || hasCoachAccess(userId));
        allow create, update: if isTrainer()
          && hasCoachAccess(userId)
          && request.resource.data.studentId == userId
          && request.resource.data.trainerId == request.auth.uid;
        allow delete: if isTrainer()
          && hasCoachAccess(userId)
          && resource.data.trainerId == request.auth.uid;
      }

      match /weight_history/{entryId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /daily_metrics/{entryId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /friends/{friendId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /social_settings/{settingId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /trainers/{trainerId} {
      allow read: if (isTrainer() && request.auth.uid == trainerId)
        || hasTrainerLibraryAccess(trainerId);
      allow write: if isTrainer() && request.auth.uid == trainerId;

      match /exercises/{exerciseId} {
        allow read: if (isTrainer() && request.auth.uid == trainerId)
          || hasTrainerLibraryAccess(trainerId);
        allow write: if isTrainer() && request.auth.uid == trainerId;
      }

      match /recipes/{recipeId} {
        allow read: if (isTrainer() && request.auth.uid == trainerId)
          || hasTrainerLibraryAccess(trainerId);
        allow write: if isTrainer() && request.auth.uid == trainerId;
      }

      match /workout_templates/{templateId} {
        allow read: if (isTrainer() && request.auth.uid == trainerId)
          || hasTrainerLibraryAccess(trainerId);
        allow write: if isTrainer() && request.auth.uid == trainerId;
      }
    }

    match /{path=**}/coach_links/{linkId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid
          || (resource.data.trainerId == request.auth.uid
            && resource.data.status == 'active'));
    }

    match /friend_invites/{inviteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUserId == request.auth.uid;
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      allow delete: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
    }

    match /coach_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.trainerId == request.auth.uid
          || resource.data.studentId == request.auth.uid);
      allow create: if isTrainer()
        && request.resource.data.trainerId == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.trainerId == request.auth.uid
          || resource.data.studentId == request.auth.uid);
      allow delete: if isTrainer()
        && resource.data.trainerId == request.auth.uid;
    }

    match /interest_chats/{chatId} {
      allow read: if isChatParticipant(chatId);
      allow create: if isFriendChatCreate()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update: if isChatParticipant(chatId)
        || (isFriendChatCreate()
          && request.resource.data.createdBy == request.auth.uid);
      allow delete: if isChatParticipant(chatId)
        && resource.data.createdBy == request.auth.uid;

      match /members/{userId} {
        allow read, write: if signedIn();
      }

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0;
        allow delete: if isChatParticipant(chatId);
      }

      match /moderation_logs/{logId} {
        allow read, write: if isChatParticipant(chatId);
      }
    }
  }
}
